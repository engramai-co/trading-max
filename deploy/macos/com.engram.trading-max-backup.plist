<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.engram.trading-max-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__TRADING_MAX_HOME__/Services/trading-max/app/deploy/macos/backup.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__TRADING_MAX_HOME__/Services/trading-max/app</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>LowPriorityIO</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__TRADING_MAX_HOME__/Library/Logs/Trading Max/backup.log</string>
  <key>StandardErrorPath</key>
  <string>__TRADING_MAX_HOME__/Library/Logs/Trading Max/backup.error.log</string>
</dict>
</plist>
