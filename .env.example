# Immutable snapshots, job records, watchlist/taxonomy state, and logs.
# Keep this outside Git in production; production must set an absolute path.
TRADING_MAX_DATA_ROOT=./runtime

# Explicit network boundary. No third mode is supported without auth.
TRADING_MAX_DEPLOYMENT_MODE=local_workstation
TRADING_MAX_ALLOWED_ORIGINS=http://127.0.0.1:3413,http://localhost:3413

# Optional write protection for POST /v1/jobs/refresh.
TRADING_MAX_API_TOKEN=

# API process.
TRADING_MAX_API_HOST=127.0.0.1
TRADING_MAX_API_PORT=8421

# Optional scheduled full refresh. Production enables four daily slots.
TRADING_MAX_NIGHTLY_ENABLED=false
TRADING_MAX_NIGHTLY_TIMEZONE=Europe/London
TRADING_MAX_FULL_REFRESH_TIMES=06:30,12:00,17:30,22:30

# Optional lightweight broker-value anchors. Production enables this through
# deploy/macos/configure-host.py; live snapshots do not verify cash flows.
TRADING_MAX_INTRADAY_ENABLED=false
TRADING_MAX_INTRADAY_INTERVAL_SECONDS=600
TRADING_MAX_INTRADAY_TIMEZONE=Europe/London
TRADING_MAX_INTRADAY_WINDOW_START=00:00
TRADING_MAX_INTRADAY_WINDOW_END=00:00
TRADING_MAX_INTRADAY_WEEKDAYS=1,2,3,4,5,6,7
TRADING_MAX_INTRADAY_RETENTION_DAYS=40

# Deterministic fake provider exercises the full pipeline without credentials.
# Switch to "opencode" or "deepseek" only after its key is installed server-side.
TRADING_MAX_LLM_PROVIDER=fake
TRADING_MAX_LLM_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Secrets are entered in Settings and stored only in the native OS credential
# store. Do not add API keys to this file.
TRADING_MAX_CREDENTIAL_SERVICE=com.engram.trading-max.credentials

# Next.js reads the API server-side. The token never reaches browser JavaScript.
PORTFOLIO_BACKEND_URL=http://127.0.0.1:8421
PORTFOLIO_BACKEND_TOKEN=
