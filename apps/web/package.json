{
  "name": "trading-max-web",
  "version": "1.47.3",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engramai-co/trading-max.git",
    "directory": "apps/web"
  },
  "bugs": "https://github.com/engramai-co/trading-max/issues",
  "homepage": "https://github.com/engramai-co/trading-max#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:architecture": "node scripts/check-frontend-architecture.mjs",
    "generate:api-types": "openapi-typescript ../../contracts/openapi.json -o lib/api-schema.ts",
    "check:api-types": "node scripts/check-api-types.mjs",
    "postbuild": "node ../../deploy/local/prepare-standalone.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3413",
    "lint": "node --test scripts/check-lint-globs.test.mjs && eslint .",
    "audit:dependencies": "node --test scripts/check-frontend-audit.test.mjs scripts/check-lint-globs.test.mjs && node scripts/check-frontend-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.107.1",
    "echarts": "^6.1.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "micromatch@4.0.8": {
      "braces": "https://codeload.github.com/micromatch/braces/tar.gz/28d440b5dd449dbf1fe6f3506cf94ecca4d02660"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
