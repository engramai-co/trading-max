{
  "name": "trading-max-web",
  "version": "1.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engramai-co/trading-max.git",
    "directory": "apps/web"
  },
  "bugs": "https://github.com/engramai-co/trading-max/issues",
  "homepage": "https://github.com/engramai-co/trading-max#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:architecture": "node scripts/check-frontend-architecture.mjs",
    "generate:api-types": "openapi-typescript ../../contracts/openapi.json -o lib/api-schema.ts",
    "check:api-types": "node scripts/check-api-types.mjs",
    "postbuild": "node ../../deploy/local/prepare-standalone.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3413",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "echarts": "^6.1.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
