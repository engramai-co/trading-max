{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trading Max Preview",
  "version": "1.9.3",
  "identifier": "com.engram.trading-max.desktop-preview",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": [
        "splash"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Finance",
    "shortDescription": "Trading Max isolated desktop runtime preview",
    "resources": {
      "../payload/": "runtime/"
    },
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
